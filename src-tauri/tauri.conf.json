{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ugrammar",
  "version": "0.1.4",
  "identifier": "dev.ugrammar.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run build",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/grammar-helper"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
